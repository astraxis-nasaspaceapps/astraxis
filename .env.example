# Copy to .env.local and fill in ONE provider (Azure is used first if all three Azure values are set). Keys stay on the server and never reach the browser.
# Without a key, the assistant still finds and ranks evidence; it just skips the written explanation.

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=   # set to a current chat model available on your account

# Azure OpenAI (Microsoft Foundry): endpoint and key from the resource's "Endpoints and key" panel,
# deployment name from "Models + endpoints" / "model deployments".
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
